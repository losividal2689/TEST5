{
  "log": {
    "loglevel": "warning",
    "dnsLog": false
  },
  "dns": {
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query",
        "domains": ["regexp:.*"]
      },
      {
        "address": "https://8.8.8.8/dns-query",
        "domains": ["regexp:.*"]
      },
      {
        "address": "https://8.8.4.4/dns-query",
        "domains": ["regexp:.*"]
      }
    ],
    "queryStrategy": "UseIP",
    "disableCache": false,
    "disableFallback": true,
    "enableParallelQuery": true,
    "useSystemHosts": false
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 10,
        "connIdle": 300,
        "uplinkOnly": 0,
        "downlinkOnly": 0,
        "bufferSize": 2048
      },
      "1": {
        "handshake": 10,
        "connIdle": 300,
        "uplinkOnly": 0,
        "downlinkOnly": 0,
        "bufferSize": 4096
      }
    },
    "system": {
      "statsInboundUplink": false,
      "statsInboundDownlink": false,
      "statsOutboundUplink": false,
      "statsOutboundDownlink": false
    }
  },
  "inbounds": [
    {
      "tag": "vless-xhttp-in",
      "listen": "127.0.0.1",
      "port": 18443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "24c8b9d5-4e71-4a8e-a96c-13d8a5726201",
            "level": 0,
            "email": "normal@cazar"
          },
          {
            "id": "e7f2b1c4-9a3d-4c5e-8b6f-7123d4e5f602",
            "level": 1,
            "email": "ai@cazar"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "/bermuda-xhttp",
          "mode": "auto",
          "xPaddingBytes": "100-1000",
          "scMaxEachPostBytes": 1000000,
          "scMaxBufferedPosts": 20,
          "scStreamUpServerSecs": "20-50"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    },
    {
      "tag": "vless-ws-in",
      "listen": "127.0.0.1",
      "port": 18444,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "24c8b9d5-4e71-4a8e-a96c-13d8a5726201",
            "level": 0,
            "email": "normal@cazar"
          },
          {
            "id": "e7f2b1c4-9a3d-4c5e-8b6f-7123d4e5f602",
            "level": 1,
            "email": "ai@cazar"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/bermuda-ws"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    },
    {
      "tag": "trojan-ws-in",
      "listen": "127.0.0.1",
      "port": 18445,
      "protocol": "trojan",
      "settings": {
        "clients": [
          {
            "password": "c9f4a8b7e2d14a5c9b6e8f1a2b3c4d5e",
            "level": 0,
            "email": "normal@cazar"
          },
          {
            "password": "f1e2d3c4b5a67890123456789abcdef0",
            "level": 1,
            "email": "ai@cazar"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/bermuda-tr"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct-normal",
      "protocol": "freedom",
      "settings": {},
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIPv4",
          "tcpNoDelay": true,
          "tcpKeepAliveIdle": 60,
          "tcpKeepAliveInterval": 15,
          "tcpUserTimeout": 30000
        }
      }
    },
    {
      "tag": "direct-ai",
      "protocol": "freedom",
      "settings": {},
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIP",
          "happyEyeballs": {
            "prioritizeIPv6": true,
            "tryDelayMs": 250,
            "interleave": 1,
            "maxConcurrentTry": 2
          },
          "tcpMaxSeg": 1360,
          "tcpNoDelay": true,
          "tcpKeepAliveIdle": 60,
          "tcpKeepAliveInterval": 15,
          "tcpUserTimeout": 30000
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {}
    }
  ],
